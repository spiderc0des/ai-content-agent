# ─── Required ────────────────────────────────────────────────────────────────

# https://platform.claude.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase → Project Settings → Database → Connection string → Transaction pooler
# NOTE: if your password contains @ % # / : or ?, percent-encode it (@ → %40).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Where this app is reachable. Used in magic-link redirects.
APP_URL=http://localhost:3000

# ─── Optional ────────────────────────────────────────────────────────────────

# Required only for the scheduled publishing worker (/api/cron/publish).
# Without it the route returns 503 rather than running unsecured.
CRON_SECRET=

# Set to 1 to serve every Claude call from test/mock-anthropic.ts fixtures.
# The whole pipeline then runs offline, with no API key and no spend.
MOCK_ANTHROPIC=0

# ─── Email (optional) ────────────────────────────────────────────────────────
# Gmail SMTP, the same transport week 3 uses. Without these, the newsletter is
# still approved, formatted and queued — it is released for a person to send
# by hand rather than delivered by the app, and the publication row records
# which of the two happened. GMAIL_APP_PASSWORD is an App Password from the
# Google account, not the account password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Koya Talent

# ─── Live posting (optional) ─────────────────────────────────────────────────
# Without these, X and LinkedIn posts are queued and released for a person to
# publish by hand — the app records which of the two happened.
#
# Encrypts OAuth tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it invalidates every stored connection.
TOKEN_ENCRYPTION_KEY=

# X app (developer.x.com) — OAuth 2.0, Confidential client, with write access.
# Callback URL to register: {APP_URL}/api/admin/channels/x/callback
# Scopes requested: tweet.read tweet.write users.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn app (linkedin.com/developers) with the Community Management product.
# Callback URL to register: {APP_URL}/api/admin/channels/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Who the posts are authored by. A company page needs w_organization_social and
# an admin role on that page; leave unset to post as the connecting member.
#   LINKEDIN_AUTHOR_URN=urn:li:organization:12345
LINKEDIN_AUTHOR_URN=
